# Copy to kit.env and edit. Every kit script sources kit.env through env.sh.

# Card profile: 4090 | 5090 | h200 | b200
CARD=h200

# The two GPUs of this machine (CUDA indices). 1-GPU experiments use the first one
# (or both lanes in parallel, see LANES); 2-GPU experiments use both.
GPUS=0,1

# Parallel 1-GPU lanes: 1 = serial (required on 4090/5090, offload shares PCIe and host RAM),
# 2 = run two 1-GPU experiments at once, one per GPU (allowed on h200/b200).
LANES=1

# Workspace on the larger disk: /personal/... on h200/b200, /scratch/... on 4090/5090
# (setup/pick_disk.sh prints the one with more free space). Holds ComfyUI/, sglang/,
# vllm-omni/, venvs, models/, the HF cache and results/.
WORKSPACE=/personal/sgld_bench

# Checkouts (setup/install.sh creates them)
COMFY_DIR=$WORKSPACE/ComfyUI
SGLANG_SRC=$WORKSPACE/sglang
VLLM_OMNI_SRC=$WORKSPACE/vllm-omni

# Python environments: SGLang + ComfyUI (track A and SGLang side of track B), vllm-omni (track B)
VENV=$WORKSPACE/venv-sglang
VENV_VLLM=$WORKSPACE/venv-vllm-omni

# HF token file on this machine (copied here by the operator; never printed)
HF_TOKEN_FILE=$WORKSPACE/.hf_token

# First port; ComfyUI lanes use PORT_BASE.., track B servers use PORT_BASE+50..
PORT_BASE=8190

# Per-run timeout in seconds (4090 with offload at 768p is slow)
TIMEOUT_S=5400

# Optional overrides of model files (leave empty for the card defaults in bench/models.py)
KIT_H3_CLIP=
